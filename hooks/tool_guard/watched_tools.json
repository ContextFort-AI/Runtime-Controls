    "curl": [
      "curl\\s+.*-d\\s",
      "curl\\s+.*--data",
      "curl\\s+.*-F\\s",
      "curl\\s+.*--form",
      "curl\\s+.*-T\\s",
      "curl\\s+.*--upload-file",
      "curl\\s+.*-X\\s+(POST|PUT|PATCH|DELETE)"
    ],
    "wget": [
      "wget\\s+.*--post-data",
      "wget\\s+.*--post-file",
      "wget\\s+.*--method\\s*=?\\s*(POST|PUT|DELETE)"
    ],
    "scp": ["scp\\s+.*\\s+\\S+@\\S+:\\S*$"],
    "rsync": ["rsync\\s+.*\\s+\\S+@\\S+:\\S*$"],
    "sftp": ["sftp\\s+"],
